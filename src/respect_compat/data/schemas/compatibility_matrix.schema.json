        "$ref": "#/$defs/row"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "semantic_contracts": {
      "items": {
        "$ref": "#/$defs/semanticContract"
      },
      "type": "array"
    },
    "semantic_hash": {
      "pattern": "^(pending|[a-f0-9]{64})$",
      "type": "string"
    },
    "source_locks": {
      "items": {
