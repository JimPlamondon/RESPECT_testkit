{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_compat/promotion_packet_v2.schema.json",
  "title": "RESPECT TestKit v2 Promotion Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "target_id",
    "target_digest",
    "matrix_id",
    "matrix_version",
    "matrix_semantic_hash",
    "challenge",
    "evidence_ids",
    "artifact_set_hash",
    "row_id",
    "responsible_party",
    "workflow_disposition",
    "substitute",
    "covered_semantics",
    "excluded_semantics",
    "real_dependency",
    "clearance",
    "promotion_test",
    "rerun_scope",
    "core_hash"
  ],
  "properties": {
    "artifact_type": {"const": "respect_promotion_packet"},
    "format_version": {"const": "2.0.0"},
    "target_id": {"type": "string", "minLength": 1},
    "target_digest": {"$ref": "#/$defs/hash"},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_version": {"type": "string", "minLength": 1},
    "matrix_semantic_hash": {"$ref": "#/$defs/hash"},
    "challenge": {"type": "string", "minLength": 16},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_set_hash": {"$ref": "#/$defs/hash"},
    "row_id": {"type": "string", "minLength": 1},
    "responsible_party": {"type": "string", "minLength": 1},
    "workflow_disposition": {"const": "provisional_promotion_required"},
    "substitute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "owner",
        "fidelity_guarantees",
        "evidence_schema"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "fidelity_guarantees": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_schema": {"type": "string", "minLength": 1}
      }
    },
    "covered_semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "excluded_semantics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "real_dependency": {"type": "string", "minLength": 1},
    "clearance": {"type": "string", "minLength": 1},
    "promotion_test": {"type": "string", "minLength": 1},
    "rerun_scope": {"enum": ["affected_rows", "full_selected_profile"]},
    "core_hash": {"$ref": "#/$defs/hash"},
    "real_build_id": {"type": "string", "minLength": 1},
    "respect_revision": {"type": "string", "minLength": 1},
    "first_applicable_version": {"type": "string", "minLength": 1},
    "last_applicable_version": {"type": ["string", "null"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
