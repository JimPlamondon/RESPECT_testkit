{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_compat/platform_gap_packet_v2.schema.json",
  "title": "RESPECT TestKit v2 Platform-Gap Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "target_id",
    "target_digest",
    "matrix_id",
    "matrix_version",
    "matrix_semantic_hash",
    "challenge",
    "evidence_ids",
    "artifact_set_hash",
    "real_build_id",
    "respect_revision",
    "first_applicable_version",
    "row_id",
    "requirement_owner",
    "control_owner",
    "responsible_party",
    "verification_mode",
    "observed_result",
    "workflow_disposition",
    "independently_attributable",
    "signed",
    "core_hash"
  ],
  "properties": {
    "artifact_type": {"const": "respect_platform_gap_packet"},
    "format_version": {"const": "2.0.0"},
    "target_id": {"type": "string", "minLength": 1},
    "target_digest": {"$ref": "#/$defs/hash"},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_version": {"type": "string", "minLength": 1},
    "matrix_semantic_hash": {"$ref": "#/$defs/hash"},
    "challenge": {"type": "string", "minLength": 16},
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact_set_hash": {"$ref": "#/$defs/hash"},
    "real_build_id": {"type": "string", "minLength": 1},
    "respect_revision": {"type": "string", "minLength": 1},
    "first_applicable_version": {"type": "string", "minLength": 1},
    "last_applicable_version": {"type": ["string", "null"]},
    "row_id": {"type": "string", "minLength": 1},
    "requirement_owner": {"type": "string", "minLength": 1},
    "control_owner": {"const": "respect_platform"},
    "responsible_party": {"const": "respect_platform_team"},
    "verification_mode": {"const": "real"},
    "observed_result": {"const": "respect_platform_gap"},
    "workflow_disposition": {"const": "dossier_eligible"},
    "independently_attributable": {"const": true},
    "signed": {"const": true},
    "core_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
