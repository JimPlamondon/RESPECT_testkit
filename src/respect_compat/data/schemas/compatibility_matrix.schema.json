        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "standard",
        "version",
        "clause",
        "source_ref",
        "invoked_surface"
      ],
      "type": "object"
    },
    "suiteMapping": {
      "additionalProperties": false,
      "properties": {
        "harness_paths": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "legacy_requirement_ids": {
          "items": {
            "minLength": 2,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "notes": {
          "minLength": 3,
          "type": "string"
        },
        "status": {
          "enum": [
            "implemented",
            "partial",
            "fixture_only",
            "planned",
            "not_implemented",
            "not_applicable"
          ]
        }
      },
      "required": [
        "status",
        "legacy_requirement_ids",
        "harness_paths",
        "notes"
      ],
      "type": "object"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    }
  },
  "$id": "https://jims.example/schemas/respect-compatibility-matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source-locked features and atomic requirements used by the RESPECT Compatible Test Suite and RESPECT-ification Kit.",
  "properties": {
    "authority_rule": {
      "minLength": 40,
      "type": "string"
    },
    "binding_equivalence_groups": {
      "items": {
        "$ref": "#/$defs/bindingEquivalenceGroup"
      },
      "type": "array"
    },
    "bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "type": "array"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/openItem"
      },
      "type": "array"
    },
    "canapp_definition": {
      "minLength": 20,
      "type": "string"
    },
    "completeness": {
      "$ref": "#/$defs/completeness"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/feature"
      },
      "type": "array"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "interface_families": {
      "items": {
        "$ref": "#/$defs/interfaceFamily"
      },
      "type": "array"
    },
    "matrix_id": {
      "pattern": "^respect-compatibility-matrix-[a-z0-9._-]+$",
      "type": "string"
    },
    "matrix_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$",
      "type": "string"
    },
    "product_boundary": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
