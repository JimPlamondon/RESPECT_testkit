{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_ification/task_packet.schema.json",
  "title": "Sanitized RESPECT-ification Task Packet",
  "type": "object",
  "required": ["artifact_type", "format_version", "run_id", "matrix_id", "matrix_version", "matrix_semantic_hash", "profile_id", "target_id", "target_digest", "challenge", "summary", "tasks", "graph_hash", "core_hash", "artifact_set"],
  "properties": {
    "artifact_type": {"const": "respect_ification_task_packet"},
    "format_version": {"const": "2.0.0"},
    "run_id": {"type": "string"},
    "matrix_id": {"type": "string"},
    "matrix_version": {"type": "string"},
    "matrix_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_id": {"type": "string"},
    "target_id": {"type": "string"},
    "target_digest": {"type": "string"},
    "challenge": {"type": "string", "minLength": 16},
    "summary": {"type": "object"},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "graph_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "core_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_set": {"type": "object"}
  }
}
