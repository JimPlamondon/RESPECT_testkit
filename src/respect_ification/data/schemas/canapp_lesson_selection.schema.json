{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_ification/canapp_lesson_selection.schema.json",
  "title": "CanApp Lesson Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "format_version", "inventory_semantic_hash", "model_semantic_hash", "selectors", "exclude_lesson_ids", "semantic_hash"],
  "properties": {
    "artifact_type": {"const": "respect_canapp_lesson_selection"},
    "format_version": {"const": "1.0.0"},
    "inventory_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "lesson_ids", "course_ids", "family_ids"],
      "properties": {
        "all": {"type": "boolean"},
        "lesson_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "course_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "family_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "exclude_lesson_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
