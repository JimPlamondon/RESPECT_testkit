{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_ification/work_plan.schema.json",
  "title": "RESPECT-ification Local Work Plan",
  "type": "object",
  "required": ["artifact_type", "format_version", "matrix_id", "matrix_version", "matrix_semantic_hash", "profile_id", "target_id", "target_digest", "run_id", "challenge", "handoff_id", "task_packet_core_hash", "authority_notice", "tasks", "semantic_hash"],
  "properties": {
    "artifact_type": {"const": "respect_ification_local_work_plan"},
    "format_version": {"const": "2.0.0"},
    "matrix_id": {"type": "string"},
    "matrix_version": {"type": "string"},
    "matrix_semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "profile_id": {"type": "string"},
    "target_id": {"type": "string"},
    "target_digest": {"type": "string"},
    "run_id": {"type": "string"},
    "challenge": {"type": "string", "minLength": 16},
    "handoff_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task_packet_core_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "private_prep_semantic_hash": {"type": ["string", "null"]},
    "authority_notice": {"type": "string"},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
