{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jims.example/schemas/respect_upgrade_dossier/upgrade_dossier_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "format_version",
    "dossier_id",
    "state",
    "affected_features",
    "affected_rows",
    "affected_profiles",
    "normative_source",
    "applicability",
    "pinned_respect",
    "independently_attributable_behavior",
    "upgrade_guidance",
    "security_implications",
    "privacy_implications",
    "compatibility_considerations",
    "migration_considerations",
    "deployment_considerations",
    "rollback_considerations",
    "acceptance_contract",
    "dependencies",
    "evidence_bindings",
    "source_packet_core_hash",
    "semantic_hash"
  ],
  "properties": {
    "artifact_type": {"const": "respect_upgrade_dossier"},
    "format_version": {"const": "2.0.0"},
    "dossier_id": {"type": "string", "pattern": "^respect-upgrade-[a-f0-9]{24}$"},
    "state": {
      "enum": [
        "identified",
        "triaged",
        "accepted",
        "in_implementation",
        "candidate_ready",
        "independently_verified",
        "closed",
        "specification_blocked",
        "duplicate",
        "superseded",
        "rejected_with_evidence"
      ]
    },
    "affected_features": {"$ref": "#/$defs/nonempty_strings"},
    "affected_rows": {"$ref": "#/$defs/nonempty_strings"},
    "affected_profiles": {"$ref": "#/$defs/nonempty_strings"},
    "normative_source": {"type": "string", "minLength": 1},
    "applicability": {"type": "string", "minLength": 1},
    "pinned_respect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_build_id",
        "respect_revision",
        "first_applicable_version",
        "last_applicable_version"
      ],
      "properties": {
        "real_build_id": {"type": "string", "minLength": 1},
        "respect_revision": {"type": "string", "minLength": 1},
        "first_applicable_version": {"type": "string", "minLength": 1},
        "last_applicable_version": {"type": ["string", "null"]}
      }
    },
    "independently_attributable_behavior": {"type": "string", "minLength": 1},
    "upgrade_guidance": {"type": "string", "minLength": 1},
    "security_implications": {"type": "string", "minLength": 1},
    "privacy_implications": {"type": "string", "minLength": 1},
    "compatibility_considerations": {"type": "string", "minLength": 1},
    "migration_considerations": {"type": "string", "minLength": 1},
    "deployment_considerations": {"type": "string", "minLength": 1},
    "rollback_considerations": {"type": "string", "minLength": 1},
    "acceptance_contract": {
      "type": "object",
      "minProperties": 1
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_digest",
        "matrix_id",
        "matrix_version",
        "matrix_semantic_hash",
        "challenge",
        "evidence_ids",
        "artifact_set_hash"
      ],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "target_digest": {"$ref": "#/$defs/hash"},
        "matrix_id": {"type": "string", "minLength": 1},
        "matrix_version": {"type": "string", "minLength": 1},
        "matrix_semantic_hash": {"$ref": "#/$defs/hash"},
        "challenge": {"type": "string", "minLength": 16},
        "evidence_ids": {"$ref": "#/$defs/nonempty_strings"},
        "artifact_set_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "source_packet_core_hash": {"$ref": "#/$defs/hash"},
    "semantic_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonempty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
