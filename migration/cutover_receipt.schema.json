{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JimPlamondon/RESPECT_testkit/migration/cutover_receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "destination",
    "matrix",
    "inventory_hash",
    "manifest_hash",
    "installed_wheel",
    "positive_reference",
    "cleanup",
    "duplicate_authority_scan"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object"
    },
    "destination": {
      "type": "object"
    },
    "matrix": {
      "type": "object"
    },
    "inventory_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installed_wheel": {
      "type": "object"
    },
    "positive_reference": {
      "type": "object"
    },
    "cleanup": {
      "type": "object",
      "required": [
        "state",
        "pull_request"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "merged"
          ]
        },
        "pull_request": {
          "type": "string",
          "format": "uri"
        },
        "head_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "merge_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "duplicate_authority_scan": {
      "type": "object"
    }
  }
}
